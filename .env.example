# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==========================================
# Google Cloud SQL / PostgreSQL Configuration
# ==========================================
# Option 1: Standard Connection String (Recommended for Vercel, Neon, Supabase, or Public IP)
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DATABASE_URL=

# Option 2: Google Cloud Run Native Connection (Cloud SQL Unix Socket)
# Set your Cloud SQL instance connection name (format: project-id:region:instance-name)
# INSTANCE_CONNECTION_NAME="my-gcp-project:asia-southeast1:my-instance"
INSTANCE_CONNECTION_NAME=

# Option 3: Individual Connection Parameters
SQL_HOST=localhost
SQL_PORT=5432
SQL_USER=postgres
SQL_PASSWORD=
SQL_DB_NAME=postgres

# SSL Configuration:
# - true: Forces SSL with rejectUnauthorized: false (required for remote Cloud SQL public IP)
# - false: Disables SSL (used automatically for Cloud Run /cloudsql/ sockets or local dev)
SQL_SSL=true

# ==========================================
# Authentication & Vercel Production Keys
# ==========================================
JWT_SECRET="your-secret-key-change-in-production"

