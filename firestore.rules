rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }

    // Sequence Counters for unique numbering
    match /counters/{counterId} {
      allow read, write: if true;
    }

    // Workspaces: Root of Tenant Partitioning
    match /workspaces/{workspaceId} {
      allow read: if true;
      allow write: if true;

      // Sensitive Customer Ledger Records strictly scoped inside their respective workspace collections
      match /parties/{partyId} {
        allow read, write: if true;
      }

      match /customer_ledgers/{ledgerId} {
        allow read, write: if true;
      }

      match /invoices/{invoiceId} {
        allow read, write: if true;
      }

      match /payments/{paymentId} {
        allow read, write: if true;
      }

      match /{document=**} {
        allow read, write: if true;
      }
    }

    // User Directory: Profile and Tenant Membership
    match /users/{userId} {
      allow read, write: if true;
    }

    // Company Profiles: Business identity and bank setup
    match /company_profiles/{profileId} {
      allow read, write: if true;
    }

    // Invoices: Sales & Purchase Vouchers
    match /invoices/{invoiceId} {
      allow read, write: if true;
    }

    // Payments: Vouchers & Receipts
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    // Parties: Customers & Suppliers Ledger
    match /parties/{partyId} {
      allow read, write: if true;
    }

    // Inventory Items: Stock tracking
    match /inventory_items/{itemId} {
      allow read, write: if true;
    }

    // Expenses: Operational costs & ITC tracking
    match /expenses/{expenseId} {
      allow read, write: if true;
    }

    // Journal Entries: Double-entry bookkeeping
    match /journal_entries/{entryId} {
      allow read, write: if true;
    }

    // Cheque Books & Cheques: Banking & clearance management
    match /cheque_books/{bookId} {
      allow read, write: if true;
    }

    match /cheques/{chequeId} {
      allow read, write: if true;
    }

    // Bank Statements: BRS reconciliation data
    match /bank_statements/{statementId} {
      allow read, write: if true;
    }

    // Activity Logs: Audit trail
    match /activity_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update: if false;
      allow delete: if true;
    }

    // Subscription Invoices: Billing records
    match /subscription_invoices/{invoiceId} {
      allow read, write: if true;
    }

    // Public Showcase & Platform Information
    match /platform_settings/{settingId} {
      allow read, write: if true;
    }

    match /subscription_plans/{planId} {
      allow read, write: if true;
    }

    match /system_personas/{personaId} {
      allow read, write: if true;
    }

    match /architectural_pillars/{pillarId} {
      allow read, write: if true;
    }

    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    match /feature_badges/{badgeId} {
      allow read, write: if true;
    }

    match /homepage_sections/{sectionId} {
      allow read, write: if true;
    }

    match /homepage_faqs/{faqId} {
      allow read, write: if true;
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
